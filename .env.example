# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "anon" (legado) ou "publishable" (novo). Qualquer um funciona; ambos são públicos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do site (links de compartilhamento, cards sociais e login).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Idade mínima exibida na confirmação inicial (Brasil). Padrão conservador: 18.
# Defina conforme orientação jurídica.
MIN_AGE_BR=18
